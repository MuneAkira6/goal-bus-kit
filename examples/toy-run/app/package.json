{
  "name": "csvq",
  "version": "0.0.0",
  "private": true,
  "description": "A tiny CSV query CLI, built by an unattended goal-bus run",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": { "node": ">=24" },
  "bin": { "csvq": "src/cli.ts" },
  "scripts": {
    "csvq": "node src/cli.ts",
